{
  // Config for the Cloudflare Workers project "personal-website" that is connected to this repo.
  // The site itself publishes through Cloudflare Pages, which ignores this file (no pages_build_output_dir).
  "name": "personal-website",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./dist" },
  // The Workers project runs `npx wrangler preview` on PR branches, which needs this block.
  "previews": {}
}
